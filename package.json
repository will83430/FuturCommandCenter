{
  "name": "futur-command-center",
  "version": "1.0.0",
  "description": "Dashboard personnel futuriste — Finances, Domotique, IA, Santé",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "server": "node backend/server.js",
    "build": "npx electron-builder",
    "import:moncompte": "node scripts/import-moncompte.js",
    "garmin:login": "node scripts/garmin-login.js"
  },
  "build": {
    "appId": "com.wilfried.futurcommandcenter",
    "productName": "FuturCommandCenter",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "frontend/**/*",
      "backend/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/.bin/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": ".garmin-session",
        "to": ".garmin-session",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  },
  "author": "Wilfried Genin <genin.wilfried@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "axios": "^1.6.0",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "garmin-connect": "^1.6.2",
    "leaflet": "^1.9.4",
    "multer": "^2.2.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^26.15.0",
    "playwright-core": "^1.61.1"
  }
}
